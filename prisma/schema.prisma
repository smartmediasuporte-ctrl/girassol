// Schema v2 — Site institucional do Restaurante Girassol (single store)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Configuração global do site (linha única, id="singleton")
model Settings {
  id                String   @id @default("singleton")
  siteName          String   @default("Restaurante Girassol")
  tagline           String   @default("Alimentação saudável há décadas em Brasília")
  primaryColor      String   @default("#E87B0F")
  secondaryColor   String   @default("#5A7A3F")

  // Contato
  whatsapp          String   @default("556132421542")
  phone             String   @default("(61) 3242-1542")
  email             String?
  instagram         String   @default("restaurantegirassolbsb")
  facebook          String?

  // Localização
  addressLine       String   @default("Asa Sul, Brasília — DF")
  mapEmbedUrl       String?  // src do iframe Google Maps

  // Horários (texto livre por dia da semana)
  hoursWeek         String   @default("Segunda a Sexta: 11h–15h e 18h–22h")
  hoursWeekend      String   @default("Sábado e Domingo: 11h–16h")

  // Conteúdo da home (CMS leve)
  heroTitle         String   @default("Há décadas cultivando saúde em Brasília")
  heroSubtitle     String   @default("Alimentação viva, natural e vegetariana. A tradição que nasce da terra.")
  heroImageUrl      String?
  aboutShort        String   @default("Mais que um restaurante, somos um ponto de encontro de quem busca uma vida mais leve, natural e consciente.")

  // Banner promocional (campanha tarde)
  promoActive       Boolean  @default(true)
  promoTitle        String   @default("Tarde no Girassol")
  promoSubtitle     String   @default("Açaí, sucos e lanches naturais com 15% off entre 14h e 17h")

  // SEO
  seoDescription    String   @default("Restaurante vegetariano tradicional em Brasília. Comida natural, sucos, açaí, lanches saudáveis e ambiente acolhedor há décadas na Asa Sul.")

  updatedAt         DateTime @updatedAt
}

model MenuCategory {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  sortOrder   Int        @default(0)
  active      Boolean    @default(true)
  items       MenuItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model MenuItem {
  id           String       @id @default(cuid())
  categoryId   String
  category     MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  slug         String       @unique
  name         String
  description  String
  imageUrl     String?
  priceCents   Int
  // Tags: vegan | vegetarian | gluten_free | lactose_free | sugar_free | raw
  tags         String       @default("") // separado por vírgula
  highlight    Boolean      @default(false) // destaca na home
  sortOrder    Int          @default(0)
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([categoryId, sortOrder])
}

model Post {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String   // markdown ou HTML simples
  coverUrl    String?
  category    String   @default("blog") // blog | evento | receita
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, publishedAt])
}

model Testimonial {
  id        String   @id @default(cuid())
  author    String
  text      String
  rating    Int      @default(5)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Sessão admin única (sem multi-tenant). Senha vem de env.
model AdminUser {
  id                String   @id @default(cuid())
  username          String   @unique @default("admin")
  passwordHash      String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
