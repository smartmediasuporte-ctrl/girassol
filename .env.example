NEXT_PUBLIC_API_URL=http://localhost:3000
API_URL_INTERNAL=http://localhost:3000
NODE_ENV=development

# ===== Banco (PostgreSQL) =====
# Local: rode docker (postgres:16) ou use Neon free tier (https://neon.tech)
# Vercel: configure no dashboard. Vercel Postgres (Neon-backed) preenche tudo automaticamente.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# DIRECT_URL é usada por prisma migrate. Necessária quando DATABASE_URL é via pgbouncer/pool.
DIRECT_URL=postgresql://user:pass@host/db?sslmode=require

# ===== Admin =====
ADMIN_PASSWORD=admin123
SESSION_SECRET=troque-este-segredo-em-prod-32chars-min

# ===== Tenant override =====
# Em URLs *.vercel.app sem domínio próprio, use ?_tenant=X para acessar uma loja.
# Ou defina DEFAULT_TENANT pra rotear sempre pra mesma loja.
# DEFAULT_TENANT=girassolemporio

# ===== Storage de imagens =====
# Em prod (Vercel): adicione a integração Vercel Blob no projeto, isso preenche este token.
# Em dev (sem token): salva em /public/uploads/ no FS local.
# BLOB_READ_WRITE_TOKEN=

# ===== Pagamento =====
PAYMENT_PROVIDER=fake

MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
